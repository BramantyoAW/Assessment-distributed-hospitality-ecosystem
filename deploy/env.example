# Environment for edge-webhook.service
# Installed at /etc/edge-webhook/env (mode 0640, owned by root:edge).
# This file is NOT in git. Replace both secrets before starting the service.

OPERA_PORT=3001

# Shared secret Opera PMS sends as `Authorization: Bearer <token>`.
OPERA_BEARER_TOKEN=replace-with-a-long-random-value

# NetSuite endpoint this Edge instance delivers to.
NETSUITE_URL=https://netsuite.example.com/api/v1/opera/events
NETSUITE_HMAC_SECRET=replace-with-the-shared-hmac-secret
NETSUITE_KEY_ID=edge-v1
NETSUITE_TIMEOUT_MS=5000

# ProtectSystem=strict makes /opt read-only, so the queue lives in StateDirectory.
OPERA_DB_PATH=/var/lib/edge-webhook/opera-queue.db

POLL_INTERVAL_MS=250
RETRY_BASE_MS=500
RETRY_MAX_DELAY_MS=30000
MAX_ATTEMPTS=5
SHUTDOWN_GRACE_MS=5000
OPERA_BODY_LIMIT=512kb
