# =============================================================================
# Copy to `.env` and fill in real values. `.env` is git-ignored.
#   cp .env.example .env
# No secret in this file is real. Never commit a real token.
# =============================================================================

# ---------------------------------------------------------------- Module 1 ---
# Shared secret Opera PMS sends as `Authorization: Bearer <token>`
OPERA_BEARER_TOKEN=change-me-opera-bearer-token

# Where the Edge middleware pushes events. Point this at the mock for local dev.
NETSUITE_URL=http://127.0.0.1:4010/api/v1/opera/events

# Shared HMAC-SHA256 secret between Edge middleware and NetSuite
NETSUITE_HMAC_SECRET=change-me-hmac-shared-secret
NETSUITE_KEY_ID=edge-v1

OPERA_PORT=3001
OPERA_DB_PATH=data/opera-queue.db

# Worker tuning (milliseconds)
POLL_INTERVAL_MS=250
RETRY_BASE_MS=500
RETRY_MAX_DELAY_MS=30000
MAX_ATTEMPTS=5
SHUTDOWN_GRACE_MS=5000
NETSUITE_TIMEOUT_MS=5000
OPERA_BODY_LIMIT=512kb

# ---------------------------------------------------------------- Module 2 ---
# Static API key the smart cameras send as `X-API-Key`
IOT_API_KEY=change-me-iot-api-key

IOT_PORT=3002
IOT_DB_PATH=data/iot-buffer.db

# Micro-batching
BATCH_INTERVAL_MS=60000
BATCH_MAX_SIZE=500
BATCH_MAX_ATTEMPTS=5
BATCH_RETRY_BASE_MS=1000
BATCH_RETRY_MAX_MS=60000
SHUTDOWN_FLUSH_MS=5000
IOT_BODY_LIMIT=64kb

# Assumed reading duration when a payload omits intervalSeconds.
IOT_DEFAULT_INTERVAL_SECONDS=60

# BigQuery adapter: `jsonl` (local file, no credential) or `bigquery` (load job)
BQ_ADAPTER=jsonl
BQ_SINK_PATH=data/bigquery-sink.jsonl
BQ_PROJECT=
BQ_DATASET=finns_hospitality
BQ_TABLE=fact_camera_events
# Where the NDJSON handed to the load job is written before it is deleted again.
BQ_TEMP_DIR=data

# --------------------------------------------------- Cloud tier (Modules 3/4) ---
# Used by `npm start` (Cloud Run Service) and `npm run job:ingest` (Cloud Run Job).
# Cloud Run injects PORT and K_SERVICE; only set what is missing.
NODE_ENV=development
BQ_GATEWAY=memory
BQ_LOCATION=asia-southeast2
BUSINESS_TIMEZONE=Asia/Makassar
QUERY_TIMEOUT_MS=10000
MAX_QUERY_ROWS=500

# Ingest job only. `NETSUITE_LOCATION_MAP` maps NetSuite location ids to
# dim_location.location_id; an empty map rejects every row as `unknown_location`
# instead of inventing a location.
NETSUITE_ACCOUNT_ID=
NETSUITE_CLIENT_ID=
NETSUITE_CERTIFICATE_ID=
NETSUITE_PRIVATE_KEY=
NETSUITE_BASE_URL=
NETSUITE_SCOPE=rest_webservices
NETSUITE_BOOTSTRAP_SINCE=2026-01-01T00:00:00Z
NETSUITE_LOOKBACK_MINUTES=10
NETSUITE_LOCATION_MAP={"2":"loc-pool","3":"loc-restaurant"}
INGEST_PAGE_SIZE=200
INGEST_MAX_PAGES=50

# ------------------------------------------------------- Mock NetSuite only ---
MOCK_NETSUITE_PORT=4010
MOCK_NETSUITE_FAIL=never
MOCK_NETSUITE_LOG=data/netsuite-received.jsonl
